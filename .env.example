# Copia este archivo a .env y rellena los valores reales.

# -------- Servicio --------
ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Tenant de las rutas: /api/v1/universities/<UNIVERSITY_ID>/agents/...
UNIVERSITY_ID=westfield

# -------- Worker (V1: stub no-op) --------
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=10

# -------- AWS S3 (bucket de conocimiento multi-agente) --------
# Estructura esperada: s3://<bucket>/agents/<agent_id>/{config.json, prompts/, vector_store/}
S3_BUCKET=westfield-agent-knowledge
AWS_REGION=us-east-1
# S3_PREFIX=agents

# Credenciales AWS — boto3 usa la cadena estándar. En local lo usual es:
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
# En ECS/EC2/Lambda usar roles IAM y borrar estas dos líneas.

# -------- Registry (caché de agentes en memoria) --------
# TTL de cada agente cargado. Cambios publicados en S3 tardan hasta este
# TTL en reflejarse en el runtime (no hace falta reiniciar).
# REGISTRY_TTL_SECONDS=300
# REGISTRY_NEGATIVE_TTL_SECONDS=30

# -------- OpenAI (proveedor LLM por defecto) --------
# Sin OPENAI_API_KEY los agentes arrancan igual pero responden su
# fallback_message (modo degradado controlado).
OPENAI_API_KEY=sk-tu_api_key_de_openai_aqui
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL_FALLBACK=text-embedding-3-small

# -------- Rate limit (por IP + agente) --------
# RATE_LIMIT_WINDOW=60
# RATE_LIMIT_MAX=12
