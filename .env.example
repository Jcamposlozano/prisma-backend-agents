# Copia este archivo a .env y rellena los valores reales.
# NUNCA commits la API key real al repo.

# -------- Servicio --------
ENV=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# -------- Worker (V1: stub no-op) --------
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=10

# -------- OpenAI (requerido para que Maia salga de modo fallback) --------
# Sin OPENAI_API_KEY, el endpoint responde con respuestas plantilladas
# (fallback offline) — útil para demos sin internet pero no para uso real.
OPENAI_API_KEY=sk-tu_api_key_de_openai_aqui

# Modelo de chat. Default: gpt-4o-mini (barato, rápido).
# Alternativas: gpt-4o, gpt-4.1-mini, gpt-4.1.
OPENAI_MODEL=gpt-4o-mini

# Modelo de embeddings — usado por el retriever en cada request para
# embeber la query del estudiante.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Opcional: cambiar el endpoint base. Útil para Azure OpenAI o proxies.
# OPENAI_BASE_URL=https://api.openai.com/v1

# -------- RAG --------
# Path al índice JSON. Default: ./data/maia-index.json.
# Generá el índice con `npm run ingest` en el proyecto Westfield_agent (Node)
# y copialo a ./data/. Mientras no exista, Maia arranca SIN RAG (sólo prompt
# base + fallback openings).
# MAIA_INDEX_PATH=./data/maia-index.json
